<Project>
    <PropertyGroup>
        <UE5RulesProjPath>$(EngineDir)/Intermediate/Build/BuildRulesProjects/UE5Rules/UE5Rules.csproj</UE5RulesProjPath>
        <UEBuildVersionPath>$(EngineDir)/Build/Build.version</UEBuildVersionPath>
    </PropertyGroup>

    <PropertyGroup Condition="Exists('$(UE5RulesProjPath)')">
        <UE5RulesContent>$([System.IO.File]::ReadAllText('$(UE5RulesProjPath)'))</UE5RulesContent>
        <UE5Rules_DefineConstants>$([System.Text.RegularExpressions.Regex]::Match($(UE5RulesContent), '&lt;DefineConstants&gt;(?&lt;content&gt;.*?)&lt;/DefineConstants&gt;').Groups['content'].Value)</UE5Rules_DefineConstants>
        <UE5Rules_DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace($(UE5Rules_DefineConstants), '\s+', ''))</UE5Rules_DefineConstants>
    </PropertyGroup>

    <!-- Installed engines have no BuildRulesProjects; read Build.version instead. -->
    <PropertyGroup Condition="!Exists('$(UE5RulesProjPath)') And Exists('$(UEBuildVersionPath)')">
        <UEBuildVersionContent>$([System.IO.File]::ReadAllText('$(UEBuildVersionPath)'))</UEBuildVersionContent>
        <UEMajorVersion>$([System.Text.RegularExpressions.Regex]::Match($(UEBuildVersionContent), '"MajorVersion"\s*:\s*(?&lt;v&gt;\d+)').Groups['v'].Value)</UEMajorVersion>
        <UEMinorVersion>$([System.Text.RegularExpressions.Regex]::Match($(UEBuildVersionContent), '"MinorVersion"\s*:\s*(?&lt;v&gt;\d+)').Groups['v'].Value)</UEMinorVersion>
        <UE5Rules_DefineConstants Condition="'$(UEMajorVersion)' != '' And '$(UEMinorVersion)' != '' And ($(UEMajorVersion) &gt; 5 Or ($(UEMajorVersion) == 5 And $(UEMinorVersion) &gt;= 8))">UE_5_8_OR_LATER</UE5Rules_DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <TargetFramework Condition="$(UE5Rules_DefineConstants.Contains('UE_5_8_OR_LATER'))">net10.0</TargetFramework>
    </PropertyGroup>

</Project>
